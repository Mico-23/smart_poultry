-- 1. Accounts Table
CREATE TABLE IF NOT EXISTS public.accounts (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_name VARCHAR(100) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(20) NOT NULL CHECK (role IN ('ADMIN', 'EMPLOYEE')),
    status VARCHAR(10) NOT NULL DEFAULT 'ACTIVE'
        CHECK (status IN ('ACTIVE', 'INACTIVE')),
    approval_status VARCHAR(10) NOT NULL DEFAULT 'PENDING'
        CHECK (approval_status IN ('PENDING', 'APPROVED', 'REJECTED')),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 2. Automated Feeding Table
CREATE TABLE IF NOT EXISTS public.automated_feeding (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    food_type VARCHAR(100) NOT NULL,
    feeding_time TIME NOT NULL,
    schedule VARCHAR(150) NOT NULL,
    is_enabled BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 3. Inventory Table
CREATE TABLE IF NOT EXISTS public.inventory (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    item_name VARCHAR(150) NOT NULL,
    category VARCHAR(100) NOT NULL CHECK (BTRIM(category) <> ''),
    quantity NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (quantity >= 0),
    unit VARCHAR(30) NOT NULL,
    expiration_date DATE,
    reorder_level NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (reorder_level >= 0),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 4. Suppliers Table
CREATE TABLE IF NOT EXISTS public.suppliers (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    supplier_name VARCHAR(150) NOT NULL,
    contact_number VARCHAR(30) NOT NULL,
    email VARCHAR(150),
    street VARCHAR(150) NOT NULL,
    barangay VARCHAR(100) NOT NULL,
    city VARCHAR(100) NOT NULL,
    province VARCHAR(100) NOT NULL,
    region VARCHAR(100) NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 5. Sensors Table (Dito nakalagay ang mga sensor mo)
CREATE TABLE IF NOT EXISTS public.sensors (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    sensor_code VARCHAR(50) NOT NULL UNIQUE,
    sensor_name VARCHAR(120) NOT NULL,
    sensor_type VARCHAR(50) NOT NULL,
    measurement_unit VARCHAR(30),
    specific_location VARCHAR(150),
    hardware_model VARCHAR(100),
    status VARCHAR(20) NOT NULL DEFAULT 'INSTALLED'
        CHECK (status IN ('INSTALLED', 'ACTIVE', 'INACTIVE', 'MAINTENANCE')),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 6. Monitoring Table (Nakakonekta sa Sensors)
CREATE TABLE IF NOT EXISTS public.monitoring (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    sensor_id BIGINT NOT NULL REFERENCES public.sensors(id)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    reading_value NUMERIC(12,4) NOT NULL,
    recorded_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    remarks VARCHAR(255),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 7. Cameras Table
CREATE TABLE IF NOT EXISTS public.cameras (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    camera_code VARCHAR(50) NOT NULL UNIQUE,
    camera_name VARCHAR(120) NOT NULL,
    camera_location VARCHAR(150),
    hardware_model VARCHAR(100),
    status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE'
        CHECK (status IN ('ACTIVE', 'INACTIVE', 'MAINTENANCE')),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 8. Camera Recordings Table
CREATE TABLE IF NOT EXISTS public.camera_recordings (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    camera_id BIGINT NOT NULL REFERENCES public.cameras(id)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    file_path VARCHAR(500) NOT NULL,
    recording_type VARCHAR(10) NOT NULL
        CHECK (recording_type IN ('IMAGE', 'VIDEO')),
    captured_at TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    detected_chicken_count INT
        CHECK (detected_chicken_count IS NULL OR detected_chicken_count >= 0),
    processing_status VARCHAR(20) NOT NULL DEFAULT 'PENDING'
        CHECK (processing_status IN ('PENDING', 'PROCESSING', 'COMPLETED', 'FAILED')),
    created_at TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 9. Chicken Detections Table
CREATE TABLE IF NOT EXISTS public.chicken_detections (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    recording_id BIGINT NOT NULL REFERENCES public.camera_recordings(id)
        ON UPDATE CASCADE ON DELETE CASCADE,
    chicken_tracking_id VARCHAR(100),
    confidence_score NUMERIC(5,4)
        CHECK (confidence_score IS NULL OR confidence_score BETWEEN 0 AND 1),
    bounding_box VARCHAR(500),
    detected_at TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- 10. Chicken Activity Table
CREATE TABLE IF NOT EXISTS public.chicken_activity (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    camera_id BIGINT NOT NULL REFERENCES public.cameras(id)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    detection_id BIGINT REFERENCES public.chicken_detections(id)
        ON UPDATE CASCADE ON DELETE SET NULL,
    chicken_tracking_id VARCHAR(100),
    activity_type VARCHAR(80) NOT NULL,
    activity_start TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    activity_end TIMESTAMP WITHOUT TIME ZONE,
    created_at TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITHOUT TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_chicken_activity_time
        CHECK (activity_end IS NULL OR activity_end >= activity_start)
);

-- 11. Inventory Supplier Table
CREATE TABLE IF NOT EXISTS public.inventory_supplier (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    inventory_id BIGINT NOT NULL REFERENCES public.inventory(id)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    supplier_id BIGINT NOT NULL REFERENCES public.suppliers(id)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    quantity_received NUMERIC(12,2) NOT NULL CHECK (quantity_received > 0),
    unit_cost NUMERIC(12,2) CHECK (unit_cost IS NULL OR unit_cost >= 0),
    date_received TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,F
    CONSTRAINT uq_inventory_supplier_receipt
        UNIQUE (inventory_id, supplier_id, date_received)
);

-- 12. Monitoring Inventory Table
CREATE TABLE IF NOT EXISTS public.monitoring_inventory (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    monitoring_id BIGINT NOT NULL REFERENCES public.monitoring(id)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    inventory_id BIGINT NOT NULL REFERENCES public.inventory(id)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    quantity_used NUMERIC(12,2) NOT NULL CHECK (quantity_used > 0),
    monitoring_date TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_monitoring_inventory_event
        UNIQUE (monitoring_id, inventory_id)
);

--13. report 
CREATE TABLE IF NOT EXISTS public.reports (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    monitoring_id BIGINT REFERENCES public.monitoring(id)
        ON UPDATE CASCADE ON DELETE SET NULL,
    inventory_id BIGINT REFERENCES public.inventory(id)
        ON UPDATE CASCADE ON DELETE SET NULL,
    automated_feeding_id BIGINT REFERENCES public.automated_feeding(id)
        ON UPDATE CASCADE ON DELETE SET NULL,
    supplier_id BIGINT REFERENCES public.suppliers(id)
        ON UPDATE CASCADE ON DELETE SET NULL,
    report_number VARCHAR(100),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);